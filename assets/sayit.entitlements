<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The only entitlement sayit needs under the Hardened Runtime.
       Accessibility (hotkey + paste) is granted by the user in System
       Settings and needs no entitlement. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
